{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Termine",
  "description": "Veranstaltungstermine nach Jahr gruppiert",
  "type": "object",
  "required": ["termine"],
  "properties": {
    "termine": {
      "type": "object",
      "description": "Objekt mit Jahreszahlen als Schlüssel (z. B. 2025), jede enthält eine Liste von Terminen",
      "patternProperties": {
        "^[0-9]{4}$": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "starttime", "location"],
            "properties": {
              "title": {
                "type": "string",
                "description": "Titel der Veranstaltung"
              },
              "location": {
                "type": "object",
                "required": ["name", "address"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Veranstaltungsort"
                  },
                  "address": {
                    "type": "string",
                    "description": "Adresse des Veranstaltungsorts"
                  },
                  "geo": {
                    "type": "object",
                    "description": "Optionale Koordinaten (WGS 84) für einen genauen Kartenlink mit Markierung. Mit zoom wird nur der Kartenausschnitt ohne Markierung geöffnet (für Gebiete wie ganz Wollbach). Ohne geo wird auf OpenStreetMap nach Name und Adresse gesucht.",
                    "required": ["lat", "lon"],
                    "properties": {
                      "lat": { "type": "number", "minimum": -90, "maximum": 90 },
                      "lon": { "type": "number", "minimum": -180, "maximum": 180 },
                      "zoom": { "type": "integer", "minimum": 1, "maximum": 19 }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "description": "Zusätzliche Beschreibung oder Hinweise"
              },
              "starttime": {
                "type": "string",
                "format": "date-time",
                "description": "Beginn der Veranstaltung (ISO 8601)"
              },
              "endtime": {
                "type": "string",
                "format": "date-time",
                "description": "Ende der Veranstaltung (ISO 8601)"
              },
              "page": {
                "type": "string",
                "description": "Optionaler Pfad einer Seite zur Veranstaltung, z. B. /blog/2026-jahreskonzert"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
