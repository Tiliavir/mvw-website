{
  "name": "mvw-website",
  "license": "MIT",
  "version": "26.02.04",
  "description": "Website of Musikverein Wollbach 1866 e.V.",
  "author": "Markus Lindenmann <tiliavir@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tiliavir/mvw-website.git"
  },
  "browserslist": [
    "last 1 version",
    "> 1%",
    "maintained node versions",
    "not dead"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/lunr": "2.3.7",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "glob-all": "3.3.1",
    "globals": "17.13.0",
    "mvw-search-index": "3.0.0",
    "postcss": "8.5.28",
    "postcss-cli": "12.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vnu-jar": "26.10.2"
  },
  "dependencies": {
    "lunr": "2.3.9",
    "lunr-languages": "1.22.0"
  },
  "scripts": {
    "validate": "node validate.mjs && echo \"\\033[33m[WARN] Validation is skipping some rules - check if still required, or if view-transitions are finally stable.\\033[0m\"",
    "lint": "stylelint '**/*.scss' && npx eslint .",
    "build": "hugo --minify && npm run validate",
    "index": "mvw-search-index '**/*.html' public/suche/index.json main --cwd public --language de --base-url / --strip-index-html",
    "postinstall": "npm run lint"
  }
}
